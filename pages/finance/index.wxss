.summary-card { background: linear-gradient(135deg,#FFF5E5,#FFF0E8); border-radius: 26rpx; padding: 30rpx; margin-bottom: 24rpx; }.month-row { display:flex; justify-content:space-between; color:#5A4535; font-size:27rpx; }.manage { color:#C26A16; font-size:24rpx; }.balance-label { color:#946D49; font-size:23rpx; margin-top:28rpx; }.balance { font-size:52rpx; font-weight:700; color:#412E20; margin:3rpx 0 22rpx; }.summary-line { display:flex; justify-content:space-between; font-size:23rpx; color:#8F7661; }.summary-line view { display:flex; flex-direction:column; gap:4rpx; }.tabs { display:flex; gap:18rpx; margin:8rpx 0 20rpx; }.tab { padding:12rpx 28rpx; background:#EAEDF3; color:#697386; border-radius:999rpx; font-size:25rpx; }.tab.active { background:#4263EB; color:#fff; }.record { display:flex; align-items:center; gap:18rpx; margin-bottom:16rpx; padding:22rpx; }.record-icon { width:68rpx; height:68rpx; display:flex; align-items:center; justify-content:center; border-radius:20rpx; background:#F5F7FB; font-size:34rpx; }.record-info { display:flex; flex:1; flex-direction:column; }.record-info .muted { font-size:22rpx; margin-top:3rpx; }.record-money { display:flex; flex-direction:column; align-items:flex-end; font-weight:600; }.delete { color:#A8B0BF; font-size:21rpx; font-weight:400; margin-top:5rpx; }.income-text { color:#12B886; }.expense-text { color:#E85952; }
