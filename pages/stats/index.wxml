<view class="page">
  <view class="filter"><picker mode="date" fields="month" value="{{month}}" bindchange="chooseMonth"><view class="month-picker"><text class="month-label">{{month}}</text><text class="month-arrow">⌄</text></view></picker><view class="user-mini"><text style="background:{{selectedUser.color}}">{{selectedUser.avatar}}</text>{{selectedUser.name}}</view></view>
  <view class="stat-tabs"><view class="stat-tab {{tab === 'finance' ? 'selected' : ''}}" data-tab="finance" bindtap="switchTab">收支分析</view><view class="stat-tab {{tab === 'study' ? 'selected' : ''}}" data-tab="study" bindtap="switchTab">学习分析</view></view>
  <view wx:if="{{tab === 'finance'}}">
    <view class="metric-row"><view class="metric card"><text class="muted">本月支出</text><text class="metric-value expense-text">¥{{finance.expenseText}}</text></view><view class="metric card"><text class="muted">本月收入</text><text class="metric-value income-text">¥{{finance.incomeText}}</text></view></view>
    <view class="card chart-card"><view class="chart-title">消费分类构成</view><canvas canvas-id="financePie" width="{{canvasWidth}}" height="{{pieCanvasHeight}}" style="width:{{canvasWidth}}px;height:{{pieCanvasHeight}}px" class="pie-chart"></canvas><view class="composition-grid" wx:if="{{financeCats.length}}"><view class="composition-item" wx:for="{{financeCats}}" wx:key="name"><view class="composition-name"><text class="dot" style="background:{{item.color}}"></text><text>{{item.name}}</text></view><view class="composition-value"><text>¥{{item.valueText}}</text><text class="composition-percent">{{item.percent}}%</text></view></view></view><view class="empty chart-empty" wx:else>暂无消费数据</view></view>
    <view class="card chart-card"><view class="chart-title">近六个月消费趋势</view><view class="chart-subtitle">每月消费金额（元）</view><canvas canvas-id="expenseBars" width="{{canvasWidth}}" height="{{barCanvasHeight}}" style="width:{{canvasWidth}}px;height:{{barCanvasHeight}}px" class="bar-chart"></canvas></view>
    <view class="card rank-card"><view class="chart-title">本月消费排行</view><view class="rank" wx:for="{{financeCats}}" wx:key="name"><text class="dot" style="background:{{item.color}}"></text><text class="rank-name">{{item.name}}</text><text>¥{{item.value}}</text></view><view class="empty small" wx:if="{{!financeCats.length}}">暂无消费数据</view></view>
  </view>
  <view wx:else>
    <view class="study-summary card"><view><text class="muted">本月学习时长</text><text class="metric-value primary">{{study.minutesText}}</text></view><view><text class="muted">连续打卡</text><text class="metric-value orange">🔥 {{streak}} 天</text></view><view><text class="muted">计划完成</text><text class="metric-value green">{{study.rate}}%</text></view></view>
    <view class="card chart-card"><view class="chart-title">近七日学习时长</view><view class="chart-subtitle">每日专注分钟数</view><canvas canvas-id="studyBars" width="{{canvasWidth}}" height="{{barCanvasHeight}}" style="width:{{canvasWidth}}px;height:{{barCanvasHeight}}px" class="bar-chart"></canvas></view>
    <view class="card rank-card"><view class="chart-title">科目学习分布</view><view class="rank" wx:for="{{studyCats}}" wx:key="name"><text class="dot" style="background:{{item.color}}"></text><text class="rank-name">{{item.name}}</text><text>{{item.value}} 分钟</text></view><view class="empty small" wx:if="{{!studyCats.length}}">暂无学习数据</view></view>
  </view>
  <view class="data-link" bindtap="goDataCenter">数据导入 / 导出与备份　›</view>
</view>
