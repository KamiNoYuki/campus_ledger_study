.filter { display:flex; justify-content:space-between; align-items:center; padding:6rpx 5rpx 24rpx; font-size:29rpx; font-weight:600; }.month-picker { display:flex; align-items:center; gap:8rpx; height:48rpx; line-height:1; }.month-label { line-height:48rpx; }.month-arrow { display:flex; align-items:center; justify-content:center; height:48rpx; color:#7A8498; font-size:30rpx; line-height:1; transform:translateY(-1rpx); }.user-mini { font-size:23rpx; font-weight:400; display:flex; align-items:center; gap:8rpx; }.user-mini text { width:42rpx; height:42rpx; border-radius:50%; color:#fff; display:flex; align-items:center; justify-content:center; }.stat-tabs { display:flex; background:#E9EDF4; border-radius:16rpx; padding:6rpx; margin-bottom:24rpx; }.stat-tab { flex:1; text-align:center; padding:15rpx; color:#727D90; }.stat-tab.selected { background:#fff; border-radius:12rpx; color:#4263EB; font-weight:700; box-shadow:0 3rpx 10rpx rgba(46,64,111,.08); }.metric-row { display:flex; gap:18rpx; }.metric { flex:1; display:flex; flex-direction:column; padding:24rpx; }.metric-value { font-size:37rpx; font-weight:700; margin-top:7rpx; }.expense-text { color:#E85952; }.income-text { color:#12B886; }.chart-card { overflow:hidden; }.chart-title { font-weight:700; font-size:29rpx; margin-bottom:3rpx; }.chart-subtitle { color:#A0A8B8; font-size:21rpx; margin-bottom:10rpx; }.pie-chart,.bar-chart { display:block; max-width:100%; margin:0 auto; }.composition-grid { display:flex; flex-wrap:wrap; border-top:1rpx solid #F0F2F5; padding-top:14rpx; }.composition-item { width:50%; display:flex; justify-content:space-between; align-items:center; padding:9rpx 12rpx 9rpx 0; font-size:23rpx; }.composition-name { display:flex; align-items:center; min-width:0; }.composition-name text:last-child { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.composition-value { display:flex; gap:8rpx; align-items:center; color:#465065; font-size:22rpx; }.composition-percent { color:#8B95A8; }.chart-empty { padding:14rpx; }.rank { display:flex; align-items:center; padding:16rpx 0; border-bottom:1rpx solid #F0F2F5; }.rank:last-child { border:0; }.dot { width:16rpx; height:16rpx; flex:none; border-radius:50%; margin-right:14rpx; }.rank-name { flex:1; }.small { padding:30rpx; }.study-summary { display:flex; justify-content:space-between; }.study-summary view { display:flex; flex-direction:column; max-width:32%; }.study-summary .muted { font-size:21rpx; }.study-summary .metric-value { font-size:30rpx; }.orange { color:#F76707; }.green { color:#12B886; }.data-link { margin:8rpx 0 20rpx; background:#EEF2FF; border-radius:18rpx; color:#4263EB; padding:23rpx; text-align:center; font-size:25rpx; }
