.type-switch { display:flex; border-radius:18rpx; overflow:hidden; background:#E9EDF4; margin-bottom:24rpx; }.switch-item { flex:1; text-align:center; padding:20rpx; color:#7A8498; }.expense-on { background:#FFF0F0; color:#E85952; font-weight:700; }.income-on { background:#E6FCF5; color:#12B886; font-weight:700; }.form-card { padding:4rpx 28rpx; }.field { min-height:106rpx; display:flex; align-items:center; justify-content:space-between; border-bottom:1rpx solid #EEF0F5; }.field:last-child { border:0; }.field-label { color:#697386; }.amount-wrap { display:flex; align-items:center; color:#4263EB; font-size:42rpx; font-weight:700; }.amount-wrap input { width:310rpx; height:90rpx; text-align:right; font-size:42rpx; }.picker-value { min-width:300rpx; text-align:right; color:#1D2638; }.picker-value text { color:#AAB1BF; margin-left:14rpx; font-size:40rpx; vertical-align:-3rpx; }.note-field { display:block; padding:24rpx 0; }.note-field textarea { width:100%; height:130rpx; margin-top:15rpx; background:#F7F8FB; border-radius:14rpx; padding:16rpx; font-size:26rpx; }.save { margin-top:34rpx; height:94rpx; min-height:94rpx; line-height:1.4; }
