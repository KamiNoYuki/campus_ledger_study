.study-hero { background:linear-gradient(135deg,#099268,#20C997); padding:30rpx; border-radius:28rpx; color:#fff; box-shadow:0 18rpx 35rpx rgba(18,184,134,.24); }.study-hero-top { display:flex; justify-content:space-between; color:rgba(255,255,255,.84); font-size:25rpx; }.study-total { display:flex; flex-direction:column; margin:32rpx 0 28rpx; color:rgba(255,255,255,.8); font-size:24rpx; }.study-total-number { font-size:54rpx; font-weight:700; color:#fff; margin-bottom:4rpx; }.study-hero-bottom { display:flex; justify-content:space-between; }.study-hero-bottom view { display:flex; flex-direction:column; color:rgba(255,255,255,.76); font-size:21rpx; }.hero-strong { color:#fff; font-size:27rpx; font-weight:650; }.section-head { display:flex; justify-content:space-between; align-items:center; margin:30rpx 2rpx 14rpx; }.section-head .section-title { margin:0; }.section-head .muted { font-size:21rpx; }.subject { display:flex; align-items:center; gap:16rpx; padding:12rpx 0; }.subject + .subject { border-top:1rpx solid #F0F2F5; }.subject-icon { width:64rpx; height:64rpx; display:flex; align-items:center; justify-content:center; border-radius:18rpx; font-size:27rpx; font-weight:700; }.subject-body { flex:1; }.subject-line { display:flex; justify-content:space-between; font-size:25rpx; margin-bottom:8rpx; }.subject-line .muted { font-size:20rpx; }.track { height:11rpx; border-radius:8rpx; overflow:hidden; background:#EEF0F5; }.fill { height:100%; border-radius:inherit; }.subject-rate { width:70rpx; text-align:right; font-size:23rpx; }.study-record { display:flex; align-items:center; gap:18rpx; padding:20rpx 22rpx; margin-bottom:16rpx; }.record-icon { width:65rpx; height:65rpx; display:flex; justify-content:center; align-items:center; background:#E6FCF5; border-radius:20rpx; color:#099268; font-size:29rpx; }.study-info { flex:1; display:flex; flex-direction:column; }.study-info .muted { font-size:21rpx; margin-top:3rpx; }.right { display:flex; align-items:flex-end; flex-direction:column; }.delete { font-size:21rpx; color:#A8B0BF; margin-top:5rpx; }
