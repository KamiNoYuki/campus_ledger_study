.tabs { display:flex; gap:18rpx; margin:0 0 20rpx; }.tab { padding:12rpx 28rpx; border-radius:999rpx; background:#EAEDF3; color:#697386; }.tab.active { background:#4263EB; color:#fff; }.category { display:flex; align-items:center; gap:15rpx; padding:20rpx; margin-bottom:16rpx; }.category-icon { width:64rpx; height:64rpx; border-radius:19rpx; display:flex; align-items:center; justify-content:center; font-size:30rpx; }.category-info { flex:1; display:flex; flex-direction:column; }.category-info .muted { font-size:21rpx; }.edit { color:#4263EB; font-size:24rpx; }.delete { color:#E85952; font-size:24rpx; margin-left:16rpx; }.mask { position:fixed; inset:0; z-index:9; background:rgba(0,0,0,.45); }.dialog { position:fixed; z-index:10; left:42rpx; right:42rpx; top:10%; max-height:80vh; overflow:auto; padding:28rpx; border-radius:24rpx; background:#fff; }.dialog-title { font-size:34rpx; font-weight:700; margin-bottom:20rpx; }.dialog input { background:#F5F7FB; border-radius:14rpx; padding:19rpx; }.field-line { display:flex; align-items:center; justify-content:space-between; padding:19rpx 0; }.field-line input { width:210rpx; text-align:right; }.label { color:#697386; font-size:24rpx; margin:12rpx 0; }.option-row { display:flex; flex-wrap:wrap; gap:12rpx; }.icon-choice { width:56rpx; height:56rpx; background:#F5F7FB; display:flex; align-items:center; justify-content:center; border-radius:14rpx; }.picked { outline:4rpx solid #4263EB; }.color-choice { height:45rpx; width:45rpx; border-radius:50%; border:5rpx solid #fff; }.color-picked { outline:3rpx solid #1D2638; }.dialog-actions { display:flex; gap:14rpx; margin-top:28rpx; }.dialog-actions button { flex:1; min-height:82rpx; }
