<view class="page">
  <view class="tabs" wx:if="{{scope === 'finance'}}"><view wx:for="{{tabs}}" wx:key="id" class="tab {{filterType === item.id ? 'active' : ''}}" data-type="{{item.id}}" bindtap="switchType">{{item.name}}分类</view></view>
  <view class="category-list" wx:if="{{list.length}}"><view class="category card" wx:for="{{list}}" wx:key="id"><view class="category-icon" style="color:{{item.color}}">{{item.icon}}</view><view class="category-info"><text>{{item.name}}</text><text class="muted" wx:if="{{scope === 'study'}}">月目标 {{item.targetMinutes}} 分钟</text><text class="muted" wx:else>{{item.type === 'income' ? '收入' : '消费'}}分类</text></view><text class="edit" bindtap="edit" data-id="{{item.id}}">编辑</text><text class="delete" bindtap="remove" data-id="{{item.id}}">删除</text></view></view>
  <view class="empty" wx:else>尚未添加{{scope === 'study' ? '学习科目' : '分类'}}</view><view class="fab" bindtap="add">＋</view>
  <view class="mask" wx:if="{{showForm}}" bindtap="close"></view><view class="dialog form-dialog" wx:if="{{showForm}}"><view class="dialog-title">{{isEdit ? '编辑' : '新增'}}{{scope === 'study' ? '学习科目' : '分类'}}</view><input value="{{form.name}}" placeholder="分类名称" data-key="name" bindinput="input" /><view class="field-line" wx:if="{{scope === 'finance'}}"><text>类型</text><text>{{form.type === 'income' ? '收入' : '消费'}}（按当前标签）</text></view><view class="field-line" wx:if="{{scope === 'study'}}"><text>月目标（分钟）</text><input type="number" value="{{form.targetMinutes}}" data-key="targetMinutes" bindinput="input" /></view><view class="label">选择图标</view><view class="option-row"><view wx:for="{{icons}}" wx:key="*this" class="icon-choice {{form.icon === item ? 'picked' : ''}}" data-icon="{{item}}" bindtap="chooseIcon">{{item}}</view></view><view class="label">选择颜色</view><view class="option-row"><view wx:for="{{colors}}" wx:key="*this" class="color-choice {{form.color === item ? 'color-picked' : ''}}" style="background:{{item}}" data-color="{{item}}" bindtap="chooseColor"></view></view><view class="dialog-actions"><button class="btn-secondary" bindtap="close">取消</button><button class="btn-primary" bindtap="save">保存</button></view></view>
</view>
