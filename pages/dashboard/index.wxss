.topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 10rpx 4rpx 28rpx;
}

.hello {
  font-size: 42rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
}

.avatar {
  height: 78rpx;
  width: 78rpx;
  border-radius: 50%;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 30rpx;
}

.hero {
  padding: 34rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #4C6EF5, #7950F2);
  box-shadow: 0 18rpx 35rpx rgba(76, 110, 245, .25);
}

.hero-label {
  color: rgba(255, 255, 255, .74);
  font-size: 25rpx;
}

.hero-money {
  font-size: 58rpx;
  font-weight: 700;
  margin: 8rpx 0 22rpx;
}

.hero-row {
  display: flex;
  gap: 35rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, .88);
}

.quick-grid {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx 0 30rpx;
  padding: 22rpx 0;
  box-shadow: 0 8rpx 30rpx rgba(46, 64, 111, .06);
}

.quick {
  flex: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 10rpx;
  color: #465065;
  font-size: 23rpx;
}

.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 400;
}

.expense {
  color: #E85952;
  background: #FFF0F0;
}

.income {
  color: #12B886;
  background: #E6FCF5;
}

.study {
  color: #4263EB;
  background: #EEF2FF;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 2rpx 16rpx;
}

.section-head .section-title {
  margin: 0;
}

.link {
  color: #4263EB;
  font-size: 24rpx;
}

.study-overview {
  padding-bottom: 24rpx;
}

.study-number {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.big {
  font-size: 40rpx;
  font-weight: 700;
}

.streak {
  padding: 16rpx 0 22rpx;
}

.fire {
  font-size: 36rpx;
}

.streak-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #F76707;
}

.progress-item {
  margin-top: 16rpx;
}

.progress-top {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.track {
  height: 12rpx;
  background: #EEF0F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: inherit;
}

.activity {
  display: flex;
  align-items: center;
  padding: 13rpx 0;
  gap: 18rpx;
}

.activity+.activity {
  border-top: 1rpx solid #F0F2F5;
}

.activity-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  background: #F5F7FB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.activity-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  font-size: 26rpx;
}

.activity-info .muted {
  font-size: 22rpx;
  margin-top: 3rpx;
}

.income-text {
  color: #12B886;
  font-weight: 600;
}

.expense-text {
  color: #E85952;
  font-weight: 600;
}