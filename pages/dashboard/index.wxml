<view class="page">
  <view class="topline">
    <view>
      <view class="hello">你好，{{user.name}}</view>
      <view class="muted">{{user.role}} · 今天也向目标靠近</view>
    </view>
    <view class="avatar" style="background: {{user.color}}">{{user.avatar}}</view>
  </view>

  <view class="hero">
    <view class="hero-label">本月可用余额</view>
    <view class="hero-money">¥ {{finance.balanceText}}</view>
    <view class="hero-row"><text>收入 ¥{{finance.incomeText}}</text><text>支出 ¥{{finance.expenseText}}</text></view>
  </view>

  <view class="quick-grid">
    <view class="quick" bindtap="go" data-url="/pages/finance-form/index?type=expense"><view class="quick-icon expense">−</view><text>记一笔消费</text></view>
    <view class="quick" bindtap="go" data-url="/pages/finance-form/index?type=income"><view class="quick-icon income">＋</view><text>记录收入</text></view>
    <view class="quick" bindtap="go" data-url="/pages/study-form/index"><view class="quick-icon study">✓</view><text>学习打卡</text></view>
  </view>

  <view class="section-head"><text class="section-title">学习概览</text><text class="link" bindtap="goTab" data-url="/pages/study/index">查看详情 ›</text></view>
  <view class="card study-overview">
    <view class="study-number"><text class="big">{{study.minutesText}}</text><text class="muted">本月已学习</text></view>
    <view class="streak"><text class="fire">🔥</text><text class="streak-num">{{streak}}</text><text class="muted"> 连续打卡天</text></view>
    <view class="progress-list">
      <view class="progress-item" wx:for="{{progress}}" wx:key="id">
        <view class="progress-top"><text>{{item.icon}} {{item.name}}</text><text class="muted">{{item.label}} · {{item.rate}}%</text></view>
        <view class="track"><view class="fill" style="width: {{item.rate}}%; background: {{item.color}}"></view></view>
      </view>
    </view>
  </view>

  <view class="section-head"><text class="section-title">最近动态</text><text class="link" bindtap="goTab" data-url="/pages/finance/index">全部记录 ›</text></view>
  <view class="card activity-card" wx:if="{{recentFinance.length || recentStudy.length}}">
    <view class="activity" wx:for="{{recentFinance}}" wx:key="id">
      <view class="activity-icon">{{item.category.icon}}</view>
      <view class="activity-info"><text>{{item.category.name}}</text><text class="muted">{{item.note || '未填写备注'}} · {{item.date}}</text></view>
      <text class="{{item.type === 'income' ? 'income-text' : 'expense-text'}}">{{item.type === 'income' ? '+' : '-'}}¥{{item.amountText}}</text>
    </view>
    <view class="activity" wx:for="{{recentStudy}}" wx:key="id">
      <view class="activity-icon">{{item.subject.icon}}</view>
      <view class="activity-info"><text>{{item.subject.name}}学习</text><text class="muted">{{item.note || '学习打卡'}} · {{item.date}}</text></view>
      <text class="primary">{{item.minutesText}}</text>
    </view>
  </view>
  <view class="empty" wx:else>还没有记录，点击上方快捷入口开始吧</view>
</view>
