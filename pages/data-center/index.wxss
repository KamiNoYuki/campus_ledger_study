.intro { display:flex; gap:20rpx; padding:28rpx; background:#EEF2FF; border-radius:24rpx; color:#65708A; font-size:23rpx; }.intro-icon { font-size:46rpx; }.intro view { display:flex; flex:1; flex-direction:column; }.intro-title { color:#2B3D7C; font-size:29rpx; font-weight:700; margin-bottom:5rpx; }.storage { display:flex; justify-content:space-between; margin-top:22rpx; }.storage view { display:flex; flex-direction:column; }.storage-num { font-size:36rpx; font-weight:700; }.storage .muted { font-size:21rpx; margin-top:3rpx; }.actions { padding:2rpx 25rpx; }.action { display:flex; align-items:center; gap:16rpx; padding:20rpx 0; }.action + .action { border-top:1rpx solid #F0F2F5; }.action > view:nth-child(2) { display:flex; flex:1; flex-direction:column; }.action .muted { font-size:21rpx; margin-top:3rpx; }.action-icon { width:60rpx; height:60rpx; border-radius:16rpx; display:flex; align-items:center; justify-content:center; font-size:24rpx; font-weight:700; }.json { background:#FFF4E6; color:#E67700; }.excel { background:#E6FCF5; color:#099268; }.csv { background:#E7F5FF; color:#1C7ED6; font-size:18rpx; }.import { background:#EEF2FF; color:#4263EB; font-size:35rpx; }.reset { background:#FFF0F0; color:#E85952; font-size:35rpx; }.arrow { margin-left:auto; color:#AAB1BF; font-size:38rpx; }.error { color:#C92A2A; background:#FFF0F0; padding:18rpx; border-radius:14rpx; font-size:23rpx; }.notice { margin:25rpx 10rpx; color:#8B95A8; text-align:center; font-size:21rpx; }
