<view class="page">
  <view class="profile-card"><view class="profile-avatar" style="background:{{user.color}}">{{user.avatar}}</view><view class="profile-info"><text class="profile-name">{{user.name}}</text><text>{{user.role}} · 当前数据视角</text></view></view>
  <view class="role-title"><text class="section-title">多角色 / 多用户</text><text class="add-role" bindtap="openAdd">＋ 新建</text></view>
  <view class="card roles"><view class="role-item {{user.id === item.id ? 'role-active' : ''}}" wx:for="{{users}}" wx:key="id" bindtap="switchUser" data-id="{{item.id}}"><view class="role-avatar" style="background:{{item.color}}">{{item.avatar}}</view><view><text>{{item.name}}</text><text class="muted">{{item.role}}</text></view><text class="checked" wx:if="{{user.id === item.id}}">✓</text></view></view>
  <view class="overview card"><view><text>{{financeCount}}</text><text class="muted">收支记录</text></view><view><text>{{studyMinutes}}</text><text class="muted">累计学习</text></view><view><text>{{streak}} 天</text><text class="muted">当前连续</text></view></view>
  <view class="section-title menu-title">设置与数据</view>
  <view class="card menu"><view class="menu-item" bindtap="go" data-url="/pages/categories/index?scope=finance"><text class="menu-icon orange-bg">▣</text><text>收支分类管理</text><text class="arrow">›</text></view><view class="menu-item" bindtap="go" data-url="/pages/categories/index?scope=study"><text class="menu-icon green-bg">◉</text><text>学习科目管理</text><text class="arrow">›</text></view><view class="menu-item" bindtap="go" data-url="/pages/data-center/index"><text class="menu-icon blue-bg">⇅</text><text>数据导入、导出与备份</text><text class="arrow">›</text></view></view>
  <view class="about">校园账学簿 · 本地数据安全存储</view>
  <view class="mask" wx:if="{{showAdd}}" bindtap="closeAdd"></view><view class="dialog" wx:if="{{showAdd}}"><view class="dialog-title">新建用户视角</view><input placeholder="请输入姓名" value="{{newName}}" bindinput="nameInput" /><picker range="{{roles}}" value="{{roleIndex}}" bindchange="roleChange"><view class="role-picker">身份：{{roles[roleIndex]}}　⌄</view></picker><view class="dialog-actions"><button class="btn-secondary" bindtap="closeAdd">取消</button><button class="btn-primary" bindtap="addUser">创建</button></view></view>
</view>
