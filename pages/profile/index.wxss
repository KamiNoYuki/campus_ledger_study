.profile-card { display:flex; align-items:center; gap:20rpx; padding:24rpx 6rpx 30rpx; }.profile-avatar { width:100rpx; height:100rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:40rpx; font-weight:700; }.profile-info { display:flex; flex-direction:column; gap:6rpx; color:#7A8498; font-size:25rpx; }.profile-name { color:#1D2638; font-size:40rpx; font-weight:700; }.role-title { display:flex; justify-content:space-between; align-items:center; }.role-title .section-title { margin:8rpx 0 18rpx; }.add-role { color:#4263EB; font-size:25rpx; }.roles { padding:8rpx 24rpx; }.role-item { display:flex; align-items:center; gap:16rpx; padding:16rpx 0; }.role-item + .role-item { border-top:1rpx solid #F0F2F5; }.role-item > view:nth-child(2) { display:flex; flex:1; flex-direction:column; }.role-item .muted { font-size:21rpx; margin-top:2rpx; }.role-avatar { height:60rpx; width:60rpx; border-radius:18rpx; color:#fff; display:flex; align-items:center; justify-content:center; }.role-active { color:#4263EB; }.checked { color:#4263EB; font-size:32rpx; }.overview { display:flex; justify-content:space-between; }.overview view { display:flex; flex-direction:column; }.overview view > text:first-child { font-size:30rpx; font-weight:700; }.overview .muted { font-size:21rpx; margin-top:4rpx; }.menu-title { margin:32rpx 0 16rpx; }.menu { padding:0 24rpx; }.menu-item { display:flex; align-items:center; gap:16rpx; padding:22rpx 0; }.menu-item + .menu-item { border-top:1rpx solid #F0F2F5; }.menu-icon { width:52rpx; height:52rpx; border-radius:15rpx; display:flex; justify-content:center; align-items:center; font-size:28rpx; }.orange-bg { background:#FFF4E6; color:#E67700; }.green-bg { background:#E6FCF5; color:#099268; }.blue-bg { background:#EEF2FF; color:#4263EB; }.arrow { margin-left:auto; color:#AAB1BF; font-size:38rpx; }.about { color:#A2AABB; text-align:center; font-size:22rpx; padding:30rpx 0; }.mask { position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:9; }.dialog { position:fixed; z-index:10; left:56rpx; right:56rpx; top:32%; padding:30rpx; border-radius:24rpx; background:#fff; }.dialog-title { font-size:34rpx; font-weight:700; margin-bottom:24rpx; }.dialog input,.role-picker { background:#F5F7FB; border-radius:14rpx; padding:20rpx; margin-bottom:18rpx; }.dialog-actions { display:flex; gap:16rpx; }.dialog-actions button { flex:1; min-height:82rpx; }
