.tip { padding:18rpx 24rpx; background:#E6FCF5; color:#087F5B; border-radius:16rpx; font-size:24rpx; margin-bottom:22rpx; }.form-card { padding:4rpx 28rpx; }.field { min-height:106rpx; display:flex; align-items:center; justify-content:space-between; border-bottom:1rpx solid #EEF0F5; }.field:last-child { border:0; }.field-label { color:#697386; }.minutes-wrap { display:flex; gap:12rpx; align-items:baseline; color:#4263EB; }.minutes-wrap input { width:190rpx; height:90rpx; text-align:right; font-size:42rpx; font-weight:700; }.picker-value { min-width:310rpx; text-align:right; }.picker-value text { color:#AAB1BF; margin-left:14rpx; font-size:40rpx; vertical-align:-3rpx; }.note-field { display:block; padding:24rpx 0; }.note-field textarea { width:100%; height:130rpx; margin-top:15rpx; background:#F7F8FB; border-radius:14rpx; padding:16rpx; font-size:26rpx; }.save { margin-top:34rpx; height:94rpx; min-height:94rpx; line-height:1.4; }
