page {
  background: #F5F7FB;
  color: #1D2638;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
view, text, button, input, textarea, picker, scroll-view { box-sizing: border-box; }
button::after { border: none; }
/* 微信 button 有默认 padding 和 line-height；统一为 flex 布局，确保文字始终居中 */
button, .btn-primary, .btn-secondary, .btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  min-height: 88rpx;
  line-height: 1.4;
  text-align: center;
}
.page { padding: 28rpx 28rpx 150rpx; }
.card { background: #FFFFFF; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 30rpx rgba(46, 64, 111, .06); }
.section-title { font-size: 34rpx; font-weight: 700; margin: 8rpx 0 20rpx; }
.muted { color: #8B95A8; }
.primary { color: #4263EB; }
.danger { color: #E85952; }
.btn-primary { background: #4263EB; color: #fff; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; }
.btn-secondary { background: #EEF2FF; color: #4263EB; border-radius: 16rpx; font-size: 28rpx; }
.btn-danger { background: #FFF0F0; color: #E85952; border-radius: 16rpx; font-size: 28rpx; }
.empty { text-align: center; padding: 80rpx 20rpx; color: #8B95A8; }
.tag { display: inline-block; padding: 5rpx 14rpx; border-radius: 999rpx; background: #EEF2FF; color: #4263EB; font-size: 22rpx; }
.fab { position: fixed; right: 34rpx; bottom: 130rpx; width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 52rpx; background: #4263EB; color: #fff; font-size: 52rpx; box-shadow: 0 12rpx 30rpx rgba(66,99,235,.35); z-index: 5; }
.divider { height: 1rpx; background: #EEF0F5; margin: 20rpx 0; }
